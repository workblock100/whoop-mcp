# Whoop OAuth app credentials — get these from https://developer.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Public URL where this server is deployed (no trailing slash).
# Whoop redirect must match this + /auth/callback exactly.
PUBLIC_URL=https://whoop-mcp-yourname.fly.dev

# Long random string. Acts as the bearer token in the MCP URL path.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_SECRET=

# Where to persist rotated Whoop refresh tokens.
# Local dev: ./tokens.json. fly.io with volume: /data/tokens.json
TOKEN_STORE_PATH=./tokens.json

# Optional: pre-populate refresh token from a prior auth (skips /auth flow on fresh deploys)
WHOOP_REFRESH_TOKEN=

# Server bind
HOST=0.0.0.0
PORT=8080
